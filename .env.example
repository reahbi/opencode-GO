# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your-bot-token-here

# Allowed Telegram user IDs (comma separated)
ALLOWED_USER_IDS=

# OpenCode server URL
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# OpenCode server credentials (optional, for HTTP Basic Auth)
# Must match the values used when starting `opencode serve`
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Default project path
DEFAULT_PROJECT=/path/to/your/project

# Instance name (optional, defaults to project directory basename)
# INSTANCE_NAME=my-project

# State directory (optional, defaults to data/)
# STATE_DIR=data/instances/my-project

# Bot role: standalone (default), writer, reader
# BOT_ROLE=standalone

# Enable group chat support (true/false)
# GROUP_CHAT_ENABLED=false

# Shared directory for bot-bot coordination (required for multi-bot groups)
# COORDINATION_DIR=/tmp/opencaddy-coordination
