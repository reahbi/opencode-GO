# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your-bot-token-here

# Allowed Telegram user IDs (comma separated)
# WARNING: The bot runs Claude with full system permissions (bypassPermissions).
# ALLOWED_USER_IDS is the ONLY security boundary. Never share your BOT_TOKEN.
ALLOWED_USER_IDS=

# Default project path (absolute path to your codebase)
DEFAULT_PROJECT=/path/to/your/project

# Claude model (optional, default: claude-sonnet-4-5)
# CLAUDE_MODEL=claude-sonnet-4-5

# Path to Claude Code executable (optional, auto-detected if on PATH)
# CLAUDE_CODE_PATH=

# Extended Thinking: max thinking tokens (optional, 0 = disabled)
# MAX_THINKING_TOKENS=0

# Max budget per session in USD (optional, no limit if unset)
# MAX_BUDGET_USD=

# OpenAI API key for Whisper voice-to-text (optional)
# OPENAI_API_KEY=

# OpenAI API base URL (optional, for proxies or Azure OpenAI)
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Claude model for summary generation (optional, default: claude-haiku-4-5)
# SUMMARY_MODEL=claude-haiku-4-5

# Instance name (optional, defaults to project directory basename)
# INSTANCE_NAME=my-project

# State directory (optional, defaults to data/)
# STATE_DIR=data/instances/my-project

# Bot role: standalone (default), writer, reader
# BOT_ROLE=standalone

# Enable group chat support (true/false)
# GROUP_CHAT_ENABLED=false

# Shared directory for bot-bot coordination (required for multi-bot groups)
# COORDINATION_DIR=/tmp/claude-go-coordination

# Enable debug logs
# DEBUG=true
