{
  "name": "opencode-go",
  "version": "0.1.0",
  "description": "Telegram bot to remotely control OpenCode coding agent",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "setup": "bun run src/cli/setup.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "start:all": "pm2 start ecosystem.config.cjs",
    "stop:all": "pm2 stop ecosystem.config.cjs",
    "logs": "pm2 logs",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath hooks",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@opencode-ai/sdk": "~1.1.48",
    "grammy": "^1.35.0",
    "telegramify-markdown": "^1.3.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
