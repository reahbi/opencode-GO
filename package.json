{
  "name": "claude-go",
  "version": "0.1.0",
  "description": "Telegram bot for Claude AI coding agent",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "hook": "bun run src/hookBot.ts",
    "setup": "bun run src/cli/setup.ts",
    "doctor": "bun run src/cli/doctor.ts",
    "start:all": "pm2 start ecosystem.config.cjs",
    "stop:all": "pm2 stop ecosystem.config.cjs",
    "logs": "pm2 logs",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath hooks",
    "build": "bun build src/main.ts --outdir dist --target bun",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.29",
    "grammy": "^1.35.0",
    "telegramify-markdown": "^1.3.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.0.0",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
