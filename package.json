{
  "name": "opencaddy",
  "version": "0.1.0",
  "description": "Telegram bot to remotely control OpenCode coding agent",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/main.ts --outdir dist --target bun"
  },
  "dependencies": {
    "@opencode-ai/sdk": "~1.1.48",
    "grammy": "^1.35.0",
    "telegramify-markdown": "^1.3.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
